# Postgres local (docker-compose lee estas variables)
POSTGRES_USER=bluelife
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=bluelife_crm
DB_PORT=5544

# Debe coincidir con las cuatro de arriba
DATABASE_URL="postgresql://bluelife:cambiame@localhost:5544/bluelife_crm?schema=public"

# --- Neon (produccion) --------------------------------------------------
# Reemplaza DATABASE_URL por la POOLED (host CON "-pooler") y agrega la
# UNPOOLED (host SIN "-pooler"), que es la que usan las migraciones.
# Ambas requieren ?sslmode=require. En local se deja vacia.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/bluelife_crm?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/bluelife_crm?sslmode=require"

# API
PORT=3000
FRONTEND_URL=http://localhost:5173

# Microsoft / SharePoint
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX_USER=ximenam@bluelifepools.com
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_LIBRARY_NAME=
SHAREPOINT_PARENT_FOLDER=
